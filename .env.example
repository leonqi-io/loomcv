# LoomCV endpoint settings — template.
#
# start.command writes the real file, .env, from your answers; you do not need to
# copy or edit this by hand. .env is ignored by git. Never commit or share it:
# it holds your API key in plain text.
#
# Write values without quotes and without spaces around "=".

# The model that writes: base URL of an OpenAI-compatible endpoint (it ends in /v1 on most servers).
LOOMCV_BASE_URL=http://localhost:11434/v1
# Its API key. Leave empty when the server needs none (a local server usually does not).
LOOMCV_API_KEY=

# The embedding model's endpoint and key. The same server as above unless your
# provider offers no embeddings API.
LOOMCV_EMBED_BASE_URL=http://localhost:11434/v1
LOOMCV_EMBED_API_KEY=
